# ──────────────────────────────────────────────────────────────────
# PIXIE — Environment Variables (template)
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored; .env.example is committed for reference.
# ──────────────────────────────────────────────────────────────────

# ─── Server ───
# LOCAL ONLY. Do NOT set PORT on Railway — Railway injects it, and
# hard-coding it makes the container unreachable behind their proxy.
PORT=3000

# ─── Twitter / X API (OAuth 1.0a — User Context) ───
# Get from https://developer.x.com → your app → "Keys and Tokens"
# Set "App permissions" to "Read and write" BEFORE generating the
# Access Token, or posting will fail with 403.

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ─── Twitter / X API (OAuth 2.0 PKCE — multi-user, optional) ───
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_OAUTH_CALLBACK_URL=http://localhost:3000/api/twitter/callback

# ─── OpenAI ───
# gpt-4o-mini powers the tweet captions + article writer (~$0.0001/call).
OPENAI_API_KEY=

# ─── AI Enhance (Restore & Upscale) ───
# One engine: OpenAI images/edits, gpt-image-1.5 falling back to gpt-image-1.
# The self-hosted upscaler and the local lanczos path were both deleted in
# 4376ef6 — there is no free path any more, every press is billed.
#
# IMAGE_QUALITY is the detail budget and the main cost lever. Prices are for
# the portrait/landscape shapes this route asks for (1024x1536 / 1536x1024):
#   low ≈ $0.013  |  medium ≈ $0.05  |  high ≈ $0.20   (per image)
# Defaults to medium. low starves the model of rendering compute and skin
# comes back waxy; high is 4× the price for detail that ends up behind the
# poster’s gradient and copy. input_fidelity is pinned to high regardless,
# which is what actually preserves faces and logos.
IMAGE_QUALITY=medium

# Set to 1 to switch AI Enhance off entirely (the route returns 503).
# DISABLE_GPT_IMAGE=

# ─── Slide 2 video (yt-dlp + ffmpeg) ───
# Runs IN this server — no separate service, no URL, no shared secret.
# The Docker image installs ffmpeg and the yt-dlp binary; /health reports
# whether both were found.
#
# Cookies are what make YouTube work from a datacenter IP (it bot-checks
# them) and are required for most of Instagram. Export cookies.txt from a
# logged-in browser, then base64 it (Railway's variable field is one line):
#     base64 -w0 cookies.txt
# Use a THROWAWAY account — these are full session credentials and
# automated access can get an account banned.
YTDLP_COOKIES=

# Optional caps.
# MAX_CLIP_SECONDS=90
# MAX_UPLOAD_BYTES=314572800

# ─── fal.ai / Flux image generation ───
# Get from https://fal.ai/dashboard/keys
FAL_KEY=

# ─── Supabase Postgres (saved pix library) ───
# Optional. Backs the Save button in the Live Preview header, which is the only
# thing that writes a post to the pix_posts table (created automatically on
# first use, or by `npm run db:init`). Unset = Save reports that no database is
# configured and /api/pix answers 503; nothing else changes.
#
# Two strings, same database. Supabase dashboard → Connect:
#   Session pooler   → SUPABASE_POOLER_URL             (IPv4 — use this one)
#   Direct connection → SUPABASE_DIRECT_CONNECTION_URL (IPv6 only)
# db.<ref>.supabase.co publishes an AAAA record and nothing else, so the direct
# string cannot connect from an IPv4-only network — most laptops, and plenty of
# hosts. The pooler is preferred when both are set. On a serverless deploy use
# the *Transaction* pooler string instead, so each invocation does not hold a
# connection open.
#
# Percent-encode special characters in the password: # → %23, @ → %40, / → %2F.
SUPABASE_POOLER_URL=
SUPABASE_DIRECT_CONNECTION_URL=

# ─── Supabase Storage (uploaded images and video) ───
# An uploaded image is a data: URL and an uploaded video is a File — neither
# has an address, so neither can be stored in a row. With these set, Save
# pushes them to the `pix-media` bucket (created automatically) and stores the
# URL that comes back. Unset = uploads still work in the editor but are lost
# when the post is reopened.
#
#   SUPABASE_URL               Project URL, e.g. https://abcdef.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY  Settings → API Keys → service_role
#
# The service_role key bypasses row-level security. It is server-only — it is
# never sent to the browser, and every upload goes through /api/media, which
# checks the session first. Treat it like the database password.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Pexels (stock images) ───
# Get from https://www.pexels.com/api/ (free). Without it the stock-image
# source is skipped — /api/stock-images returns "Pexels API key is missing"
# and the app falls back to web image search.
PEXELS_API_KEY=

# ─── DailyMattr / Shortly India CMS publishing ───
# Publishes a finished post to public.dailymattr.com as "Buzz Content": the
# browser exports the slide PNGs, this server attaches the credentials and
# forwards them, so the API key never reaches the client.
#
# DAILYMATTR_EMAIL / DAILYMATTR_PASSWORD are exchanged for a 24h bearer token
# (cached in-process). DAILYMATTR_API_KEY is sent alongside it on every call —
# the API requires BOTH headers and returns 401 if either is missing.
#
# Unset = the publish panel reports "not configured" and nothing is sent.
DAILYMATTR_API_KEY=
DAILYMATTR_EMAIL=
DAILYMATTR_PASSWORD=

# Optional. Defaults to the URL below; only set it to point at a staging host.
# DAILYMATTR_BASE_URL=https://public.dailymattr.com/api/integrations/sub-editor-states

# Optional. Per-file cap for slide uploads (default 25 MB).
# MAX_DAILYMATTR_MEDIA_BYTES=26214400

# Compress clips before sending them to DailyMattr. A 31s 1080x1996 clip
# encodes to ~12.6 MB at our normal quality, which their API accepts with
# success:true and then does not store — their per-file limit is undocumented.
# Capped CRF gets that to ~7.5 MB with no visible loss (SSIM 0.9935,
# PSNR 43.8 dB). Videos already under the target are passed through untouched.
#   DAILYMATTR_TARGET_VIDEO_MB=9    target ceiling in MB (0 disables)
#   DAILYMATTR_VIDEO_CRF=23         quality target; lower = better and larger
# DAILYMATTR_TARGET_VIDEO_MB=9
# DAILYMATTR_VIDEO_CRF=23

# Which DailyMattr categories QA may publish into, and their order in the
# dropdown. Names are matched against their /categories list — IDs always come
# from them, never hard-coded here. A name they do not offer is skipped with a
# warning at startup. Leave unset for the default list; set it empty to show
# every category they offer.
# DAILYMATTR_CATEGORIES=Entertainment,Technology,Lifestyle,State,International,National,Finance,Sports
